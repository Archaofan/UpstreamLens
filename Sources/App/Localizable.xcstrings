    },
    "%lld upstream items were published at once; listed as one summary item to avoid flooding the list.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld upstream items were published at once; listed as one summary item to avoid flooding the list."
