    },
    "The Sources tab groups your repos by category and lets you search by name, purpose or tag. Categories are yours to edit in Settings → Categories.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Sources tab groups your repos by category and lets you search by name, purpose or tag. Categories are yours to edit in Settings → Categories."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「来源」页按类别分组，并支持按名称、用途或标签搜索。类别可以在「设置 → 类别管理」里自由增删改。"
          }
        }
      }
    },
    "The app defaults to English. You can switch to Simplified Chinese or follow the system language anytime.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app defaults to English. You can switch to Simplified Chinese or follow the system language anytime."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用默认英文。你可以随时切换到简体中文，或跟随系统语言。"
          }
        }
      }
    },
    "The backup contains %lld sources and %lld records; importing will replace your current %lld sources.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup contains %lld sources and %lld records; importing will replace your current %lld sources."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份中包含 %lld 个来源、%lld 条记录，导入后将替换现有的 %lld 个来源。"
          }
        }
      }
    },
    "The change mentions your recorded purpose or rationale “{terms}”.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change mentions your recorded purpose or rationale “{terms}”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "变更提及你记录的用途或理由「{terms}」。"
          }
        }
      }
    },
    "The change mentions your watched keyword(s) “{terms}”. Check the original wording against how you use it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change mentions your watched keyword(s) “{terms}”. Check the original wording against how you use it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "变更提及你关注的关键词「{terms}」。请核对原文与当前用途。"
          }
        }
      }
    },
    "The change mentions “{term}”, which usually signals a compatibility or security impact. Check the original wording against how you use it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change mentions “{term}”, which usually signals a compatibility or security impact. Check the original wording against how you use it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "变更包含「{term}」，通常涉及兼容性或安全，请核对原文与当前用途。"
          }
        }
      }
    },
    "The first successful check only sets a baseline; new changes are reported after that.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first successful check only sets a baseline; new changes are reported after that."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次成功检查只建立基线，之后的检查才会报告新变化。"
          }
        }
      }
    },
    "The first successful check only sets a baseline; old versions are not treated as new changes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first successful check only sets a baseline; old versions are not treated as new changes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次成功检查只建立基线，不会把旧版本当成新变化。"
          }
        }
      }
    },
    "The first successful check records the current baseline only; historical versions are not treated as new changes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first successful check records the current baseline only; historical versions are not treated as new changes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次成功检查只记录当前基线，不会把历史版本当成新变化。"
          }
        }
      }
    },
    "The list contains %lld sources and will be merged into your current %lld: existing sources are not modified or deleted, and duplicate repos are skipped automatically. A check runs right after import.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The list contains %lld sources and will be merged into your current %lld: existing sources are not modified or deleted, and duplicate repos are skipped automatically. A check runs right after import."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清单包含 %lld 个来源，将合并到现有的 %lld 个：已有来源不会被修改或删除，重复仓库自动跳过。导入后立即检查一轮。"
          }
        }
      }
    },
    "The previously known upstream item no longer exists upstream, so new changes cannot be judged safely.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previously known upstream item no longer exists upstream, so new changes cannot be judged safely."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次已知的上游条目已不存在，无法安全判断新变化。"
          }
        }
      }
    },
    "The theme only changes the accent color. A custom background replaces the page background; opacity, brightness and the readability shade are adjustable and can be turned off anytime. These preferences stay on this device and are never included in backups.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The theme only changes the accent color. A custom background replaces the page background; opacity, brightness and the readability shade are adjustable and can be turned off anytime. These preferences stay on this device and are never included in backups."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题只改变强调色。自定义背景会替换页面底色；透明度、亮度与可读性压暗都可调节，也可随时关闭。这些偏好仅保存在本机，不会包含在备份中。"
          }
        }
      }
    },
    "The token is invalid or has been revoked. Check it and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The token is invalid or has been revoked. Check it and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "令牌无效或已被撤销，请检查后重试。"
          }
        }
      }
    },
    "The token is stored only in the local Keychain; it is never uploaded or written into exported backups, and you can revoke it anytime via “Sign Out” in Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The token is stored only in the local Keychain; it is never uploaded or written into exported backups, and you can revoke it anytime via “Sign Out” in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "令牌仅保存在本机 Keychain，不会上传，也不会写进导出备份；可随时在设置里“登出”撤销。"
          }
        }
      }
    },
    "The upstream version matches the version you recorded.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upstream version matches the version you recorded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上游版本与你记录的使用版本一致。"
          }
        }
      }
    },
    "The version you recorded is ahead of the upstream identifier (a development build, or a different numbering scheme). Check the original.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The version you recorded is ahead of the upstream identifier (a development build, or a different numbering scheme). Check the original."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你记录的使用版本高于上游标识（可能是开发版或不同编号方式），请核对原文。"
          }
        }
      }
    },
    "Theme": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Theme"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题配色"
          }
        }
      }
    },
    "This device does not support alternate app icons.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device does not support alternate app icons."
          }
