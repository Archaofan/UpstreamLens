    "Alternate icons are installed with the app. The system may briefly show a notification while switching. This preference stays on this device and is never included in backups.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternate icons are installed with the app. The system may briefly show a notification while switching. This preference stays on this device and is never included in backups."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备用图标随 App 一起安装。切换时系统可能会短暂弹出提示。此偏好仅保存在本机，不会包含在备份中。"
          }
        }
      }
    },
