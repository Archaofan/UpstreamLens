{
  "sourceLanguage": "en",
  "strings": {
    "%lld items will move to handled records; this means you have finished reviewing them locally.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld items will move to handled records; this means you have finished reviewing them locally."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共 %lld 条将进入已处理记录；这表示你已完成本地核查。"
          }
        }
      }
    },
    "%lld sources": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sources"
          }
        },
        "zh-Hans": {
