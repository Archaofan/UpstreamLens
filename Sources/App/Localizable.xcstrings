        }
      }
    },
    "Added %lld sources, skipped %lld duplicates.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added %lld sources, skipped %lld duplicates."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已新增 %lld 个来源，跳过 %lld 个重复项。"
          }
        }
      }
    },
    "Adding purpose, keywords, and the version in use improves accuracy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adding purpose, keywords, and the version in use improves accuracy."
