      }
    },
    "This info is only used locally to judge relevance; it is never sent to GitHub.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This info is only used locally to judge relevance; it is never sent to GitHub."
          }
        },
