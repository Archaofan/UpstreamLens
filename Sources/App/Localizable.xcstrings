    "Add a repo in the Sources tab; the first successful check sets the baseline.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a repo in the Sources tab; the first successful check sets the baseline."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「来源」页添加仓库；首次成功检查只建立基线。"
          }
        }
      }
    },
    "Add a repo to start tracking its releases.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a repo to start tracking its releases."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加一个仓库，开始跟踪它的版本发布。"
