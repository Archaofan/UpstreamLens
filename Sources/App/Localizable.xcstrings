        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仓库文件过多，列表不完整；请手动输入路径。"
          }
        }
      }
    },
    "Try another keyword, or clear the tag filter.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try another keyword, or clear the tag filter."
          }
        },
