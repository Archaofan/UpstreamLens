          "stringUnit": {
            "state": "translated",
            "value": "补充用途、关键词和使用版本后，判断会更准。"
          }
        }
      }
    },
    "After generating, copy the token, return to Settings, paste it, and tap “Sign In and Verify”.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After generating, copy the token, return to Settings, paste it, and tap “Sign In and Verify”."
